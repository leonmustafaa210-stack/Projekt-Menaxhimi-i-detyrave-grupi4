        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Stilimi i Nyjeve\n    classDef authFill fill:#e1d5e7,stroke:#9673a6,stroke-width:2px;\n    classDef dashFill fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px;\n    classDef taskFill fill:#fff2cc,stroke:#d6b656,stroke-width:1px;\n    classDef alertFill fill:#f8cecc,stroke:#b85450,stroke-width:1px;\n    classDef endFill fill:#d5e8d4,stroke:#82b366,stroke-width:2px;\n\n    %% --- FAZA 1: AUTENTIKIMI (Autentikimi &amp; Regjistrimi) ---\n    Start([Fillimi]) --&gt; A{A ka llogari?}\n    \n    A -- JO --&gt; Reg[Faqja e Regjistrimit]\n    Reg --&gt; RegCheck{Të dhënat valide?}\n    RegCheck -- JO --&gt; AlertReg[Shfaq Gabim: Plotëso fushat] --&gt; Reg\n    RegCheck -- PO --&gt; Log[Faqja e Log-in]\n    \n    A -- PO --&gt; Log\n    Log --&gt; LogCheck{Kredencialet saktë?}\n    LogCheck -- JO --&gt; AlertLog[Shfaq Gabim: Pasword i gabuar] --&gt; Log\n\n    %% --- FAZA 2: DASHBOARD (Udhëkryqi Kryesor) ---\n    LogCheck -- PO --&gt; Dash[Dashboard Kryesor]\n    \n    Dash --&gt; Menu{Zgjidh Veprimin}\n    \n    %% --- FAZA 3: MENAXHIMI I DETARAVE (Me Kushte) ---\n    Menu --&gt;|1. Krijo Detyrë| Create[Krijo Detyrë të Re]\n    Create --&gt; TaskCheck{A janë të gjitha të dhënat?}\n    TaskCheck -- JO --&gt; AlertTask[Gabim: Vendos titullin/afatin] --&gt; Create\n    TaskCheck -- PO --&gt; Process[Në Proces / Duke u punuar]\n    \n    Menu --&gt;|2. Shiko Detyrat ekzistuese| Process\n    \n    Process --&gt; Review{A ka nevojë për rishikim?}\n    Review -- PO --&gt; Process\n    Review -- JO --&gt; Done([Detyra e Përfunduar]) --&gt; Dash\n    \n    %% --- FAZA 4: DALJA (Log-out) ---\n    Menu --&gt;|3. Log out| Logout[Kliko Log out]\n    Logout --&gt; Confirm{A jeni i sigurt?}\n    Confirm -- JO --&gt; Dash\n    Confirm -- PO --&gt; End([Seksioni u mbyll / Faqja Kryesore])\n\n    %% Aplikimi i stilit sipas kategorive\n    class Reg,Log authFill;\n    class Dash,Menu dashFill;\n    class Create,Process taskFill;\n    class A,RegCheck,LogCheck,TaskCheck,Review,Confirm,AlertReg,AlertLog,AlertTask alertFill;\n    class Start,Done,End endFill;\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="l767s6yG48U0Y-wtdQ1u-564">
